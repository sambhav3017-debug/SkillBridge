# ==============================================================================
# SkillBridge Environment Configuration Template (.env.example)
# Copy this file to .env.local or .env in your deployment environment.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Application Port (default: 3000)
PORT=3000

# Custom Data Directory for local JSON store (defaults to ./.data or /tmp on Vercel)
SKILLBRIDGE_DATA_DIR=

# PostgreSQL Database Connection URL (Optional: used for Prisma migrations when enabled)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/skillbridge?schema=public"
